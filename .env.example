# --- AI model (use a plant model, not default COCO) ---
# Presets: plant_disease | agrosight | plant_local | coco_demo | custom
MODEL_PRESET=plant_disease

# Auto-set by preset → weights/plant_disease.pt (downloaded on first run)
# Or pre-download: python scripts/download_model.py --preset plant_disease

# How to flag "issue": keywords in class name (recommended for plant models)
ISSUE_MATCH_MODE=keywords
ISSUE_KEYWORDS=blight,rust,scab,mold,rot,spot,virus,wilt,pest,weed,disease

CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
# DEVICE=cpu

RETURN_ANNOTATED_IMAGE=true
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=*
